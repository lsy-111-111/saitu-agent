NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com

# Product feature switches.
FEATURE_AI=1
FEATURE_COMPETITION_RECOMMENDER=1

# PostgreSQL stores AI consent audit rows plus shared, content-minimized security
# state. Idempotent response bodies are encrypted before persistence.
# e.g. postgresql://saitu:password@localhost:5432/saitu
DATABASE_URL=
# Long, random, server-only salt used to hash network addresses in AI consent records.
AI_CONSENT_SALT=
# Independent 32+ character server-only key for short-lived competition conversation tokens.
AI_CONVERSATION_SIGNING_SECRET=
# Independent 32+ character HMAC key for pseudonymous request/session log identifiers.
# Production must generate this secret outside release archives.
LOG_HASH_SECRET=

# Competition quota names are documented here for local development only.
# Production values are generated exclusively from ops/config/quotas.conf into
# /etc/resume-ai/quota.env; do not maintain a second production value set here.
SESSION_STARTS_PER_IP_MINUTE=
SESSION_STARTS_PER_IP_DAY=
SESSION_TRANSITIONS_PER_SESSION=
SESSION_TTL_SECONDS=
AI_CONCURRENCY_MAX=
AI_QUEUE_MAX=
AI_QUEUE_WAIT_MS=
AI_MODEL_CALLS_PER_DAY=
AI_BUDGET_TIMEZONE=

# Non-AI analytics ingestion throttle.
MAX_TRACK_PER_IP_MINUTE=60

# Optional Supabase analytics storage. Both values are server-runtime-only;
# never expose either through a NEXT_PUBLIC_ variable. Leave both blank to
# keep event persistence dormant.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek-only server settings. Production accepts these exact official
# endpoints (or an empty value, which resolves to the same defaults). Never
# expose AI_API_KEY with NEXT_PUBLIC_.
AI_PROVIDER=deepseek
AI_API_URL=https://api.deepseek.com/chat/completions
AI_MODELS_URL=https://api.deepseek.com/models
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_COMPETITION_NORMALIZE_MODEL=deepseek-v4-pro
AI_COMPETITION_CLARIFY_MODEL=deepseek-v4-pro
AI_COMPETITION_RECOMMEND_MODEL=deepseek-v4-pro
AI_TIMEOUT_MS=30000
AI_RETRY_MAX_DELAY_MS=5000
AI_VERIFY_TIMEOUT_MS=45000
# Mock is reserved for explicit E2E runs. Never enable these in production.
AI_TEST_MODE=0
ALLOW_AI_MOCK=0
NEXT_PUBLIC_AI_TEST_MODE=0
