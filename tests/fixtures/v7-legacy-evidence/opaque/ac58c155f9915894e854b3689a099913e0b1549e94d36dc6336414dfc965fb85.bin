'robotics': ([10,23,24,25,56,63,65,83,86,101], [4,15,30,32,39,44,51,54,57,59,72,94,95,131], [0,1,11,12,17,22,26,33,34,35,36,40,48,55,58,69,82,85,87,88,89,102,103,105,118,121,132]),
'visual-design': ([18,29,40,43,45,49,64], [11,16,17,66,73,92,97,116,118,119,124,127,129], [0,3,9,13,20,30,34,35,37,39,42,48,54,55,62,81,85,87,88,89,103,117,120,121]),
'career-language': ([13,7,27,66,67,108,109], [20,43,92,97,127,129,130], [3,6,9,18,28,31,38,45,49,64,78,79,80,84,85,87,88,89,96,110,111,112,114,115,116,117,120,125,126]),
'chemistry-lab': ([70,71,122], [47,52,60,61,77,99,104,106,123,124,132], [0,1,8,19,33,35,36,37,46,50,51,53,54,69,76,103,134]),
'digital-building': ([16,42,62,81], [39,40,54,69,73,75,105,106,107,118], [0,1,8,17,19,29,30,33,34,35,36,37,44,45,46,49,50,52,53,55,64,83,92,119,120,131,132,134]),
'medical-research': ([60,77,99], [1,36,61,71,76,103,104,122,123], [0,2,8,19,33,35,37,46,47,52,69,70,82,93,95,98,124]),
'electronics': ([4,15,32,51,57,59,94], [10,22,23,24,25,26,30,39,41,44,54,56,58,61,63,65,72,83,86,101,102,131], [0,1,11,12,14,17,33,34,35,36,40,46,48,55,69,74,82,85,87,88,89,95,103,118,121,132]),
'finance-tax': ([28,78,84,113,114], [6,19,20,21,38,76,79,80,115,130], [0,3,9,13,31,34,35,36,37,48,82,85,87,88,89,92,96,116,117,120,121,127]),
'modeling': ([2,76,93,98], [6,19,53,82,91,102,105,113,133,134], [1,5,12,14,21,22,28,41,47,50,58,65,68,72,74,75,78,90,95,96,100,107,114,123]),
'public-management': ([6,96,120], [1,8,19,36,37,92,97,127], [0,3,9,13,20,21,28,31,34,35,46,48,55,66,67,76,78,79,80,85,89,105,107,110,111,112,113,114,115,116,117,119,125,126,128]),
'culture': ([7,66,67,97,108,109], [18,27,43,45,49,64,92,129], [1,3,6,9,13,20,29,36,37,40,73,96,110,111,112,116,117,119,120,125,126,127]),
'software': ([11,12,22,41,48,58,72,102,121], [5,14,26,28,29,32,56,57,59,65,74,82,90,95,100], [0,1,2,9,10,23,24,25,33,34,35,36,40,55,62,63,68,75,76,81,83,93,94,98,101,103,105,107,133]),
'venture': ([0,3,9,31,35,55,116,117,121], [20,21,28,34,37,38,46,48,79,80,92,114,115,118,119,120,124,127], [1,6,8,11,12,13,17,19,29,30,33,36,39,40,43,45,49,54,56,64,65,69,78,81,83,84,89,94,95,96,97,99,103,113,130]),
'green': ([8,19,37,69,119], [1,30,36,55,83,99,105,117,120,128], [0,2,3,6,9,17,21,25,33,34,35,39,42,44,46,47,50,52,53,54,61,70,71,73,75,76,81,92,93,96,98,103,106,107,118,122,123,124,131,132,134]),
'field-research': ([6,96,120], [1,8,19,36,37,50,67,75,76,78,92,97,105,107,127,134], [0,3,9,13,20,21,28,31,34,35,46,55,69,73,79,80,93,98,110,111,112,113,114,115,116,117,119,125,126,128]),
'general-research': ([1], [6,19,36,46,76,96,97,120], [0,2,3,8,9,13,20,21,28,31,33,35,37,50,55,66,67,73,75,78,92,93,98,105,107,110,111,112,113,114,115,117,125,126,127,128,134]),
