"""Independent AI rubric materializer; NOT application scoring code or human gold.
Only source inputs are the three allowlisted blinded files. Manual semantic
anchor lists below were authored after reading the candidate summaries.
"""
import json, hashlib, collections
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
SRC = ROOT / 'artifacts/v6/legacy-review-20261105'
OUT = Path(__file__).resolve().parent
def read(name): return json.loads((SRC/name).read_text())
manifest = read('manifest.json')
inputs = [json.loads(l) for l in (SRC/'review-inputs.jsonl').read_text().splitlines()]
catalog = read('candidate-pool.json')['catalog']
byid = {c['id']:c for c in catalog}
assert hashlib.sha256((SRC/'review-inputs.jsonl').read_bytes()).hexdigest() == '6d40b8e88be560f38ea735c90cb07690cc43bddb402af12584f31fe6761696e7'
assert hashlib.sha256((SRC/'candidate-pool.json').read_bytes()).hexdigest() == '8a8549da1cd0ac32a03cce3549f720fd334ef86f939143827a9e930f8f586cf0'

# Indexes refer only to the frozen 135 candidate source order. Lists are an AI
# semantic judgment, not overlaps with application tags, golds, or outputs.
# Level 3 = direct task; 2 = substantial transferable/adjacent task; 1 = indirect
# project vehicle or peripheral task; unlisted = 0 (not ability incompetence).
M = {
'algorithm': ([5,26,68,82,90,100], [2,11,12,14,22,41,58,59,65,72,74,76,93,95,98,102,133], [0,1,6,9,19,23,24,25,28,29,32,33,35,36,48,56,63,94,101,107,121,134]),
'ai-research': ([82,95], [1,2,5,11,12,14,22,24,28,41,48,56,58,59,63,65,68,72,74,76,93,94,98,100,102,133], [0,6,9,19,23,25,26,32,33,35,36,90,101,103,105,107,121,134]),
