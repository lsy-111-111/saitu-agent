{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-continuation/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-performance/types/**/*.ts",
    ".next-specialist-student-20261106/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-v7-browser/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-e2e",
    "artifacts",
    "tmp"
  ]
}
