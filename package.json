{
  "name": "resume-ai-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run --passWithNoTests",
    "test:ai:live": "RUN_DEEPSEEK_LIVE=1 vitest run tests/ai/deepseek-live.test.ts --testTimeout=3600000",
    "verify:assets": "node scripts/verify-next-assets.mjs",
    "verify:deepseek": "node scripts/verify-deepseek.mjs",
    "cleanup:security-state": "node scripts/cleanup-security-state.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_PRODUCTION=1 playwright test",
    "evidence:release": "node scripts/run-release-evidence.mjs",
    "evidence:deep-scan:export": "node scripts/export-deep-scan-evidence.mjs",
    "evidence:deep-scan:close": "node scripts/export-deep-scan-finding-closure.mjs",
    "evidence:deep-scan:finalize": "node scripts/finalize-deep-scan-evidence.mjs",
    "evidence:verify": "node ops/bin/verify-release-evidence.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "next": "15.5.24",
    "pg": "^8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/env": "15.5.24",
    "@playwright/test": "^1.60.0",
    "@types/node": "24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "playwright": "^1.60.0",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  }
}
