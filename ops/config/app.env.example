AI_COMPETITION_RECOMMEND_MODEL=deepseek-v4-pro
AI_TIMEOUT_MS=30000
AI_RETRY_MAX_DELAY_MS=5000
AI_TEST_MODE=0
ALLOW_AI_MOCK=0
NEXT_PUBLIC_AI_TEST_MODE=0
