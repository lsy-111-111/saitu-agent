# Install as /etc/resume-ai/app.env with owner root:resume-ai and mode 0640.
# Values below are placeholders. Never commit the populated file.
DATABASE_URL=
AI_API_KEY=
AI_CONSENT_SALT=
AI_CONVERSATION_SIGNING_SECRET=
LOG_HASH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://siyuanjiaxin.com
NEXT_PUBLIC_CONTACT_EMAIL=privacy@siyuanjiaxin.com
FEATURE_AI=1
FEATURE_COMPETITION_RECOMMENDER=1
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_COMPETITION_NORMALIZE_MODEL=deepseek-flash
AI_COMPETITION_CLARIFY_MODEL=deepseek-flash
AI_COMPETITION_RECOMMEND_MODEL=deepseek-flash
AI_REASONING_EFFORT=high
SAITU_AI_EXECUTION_MODE=user-unbounded
AI_SPEND_AUTHORIZED_EFFORT=stage
AI_SPEND_HIGH_CONDITION_SHA256=
AI_SPEND_EFFORT_CONDITION_SHA256=
# New mode uses an existing saitu-v7-top5-unbounded-20261109-PHASE-NN grant.
# Bind the unbounded contract/condition hashes; profile/chat remain high.
# Never source this file. Legacy numeric caps below are ignored only in this mode.
SAITU_V7_EFFORT_POLICY={"version":"saitu.effort-policy.v1","rank":"low","explain":"low","review":"low"}
SAITU_V7_EFFORT_POLICY_SHA256=04962f576d20346af8a8f076ce64fdbda5aea13fdbd2fae39f3c7456fe30aa48
AI_CALIBRATION_CALL_LIMIT=
# Existing administrator-approved spend run; never initialize/reset from app.
AI_SPEND_POLICY_SHA256=
# Bind a previously opened user-unbounded grant and its phase. PostgreSQL remains the
# existing common authority; this template cannot create or enlarge a grant.
AI_SPEND_RUN_ID=
AI_SPEND_LIMIT_CNY=
AI_SPEND_FUNDED_CNY=
AI_SPEND_PHASE=formal
SAITU_DECISION_STRATEGY=llm
SAITU_V7_WORKER_CONCURRENCY=
# SAITU_V7_SOURCE_SHA256 is derived from the signed build, never app.env.
AI_TIMEOUT_MS=30000
AI_RETRY_MAX_DELAY_MS=5000
AI_TEST_MODE=0
ALLOW_AI_MOCK=0
NEXT_PUBLIC_AI_TEST_MODE=0
