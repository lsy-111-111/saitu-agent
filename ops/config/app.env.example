# Install as /etc/resume-ai/app.env with owner root:resume-ai and mode 0640.
# Values below are placeholders. Never commit the populated file.
DATABASE_URL=
AI_API_KEY=
AI_CONSENT_SALT=
AI_CONVERSATION_SIGNING_SECRET=
LOG_HASH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
